@@ -426,0 +431,31 @@
+#ifdef XP_LINUX
+/* static */
+already_AddRefed<Promise> IOUtils::ReadVolparossaGrant(
+    GlobalObject& aGlobal, const nsAString& aPath, ErrorResult& aError) {
+  return WithPromiseAndState(aGlobal, aError, [&](Promise* promise, auto& state) {
+    nsCOMPtr<nsIFile> file = new nsLocalFile();
+    if (NS_FAILED(PathUtils::InitFileWithPath(file, aPath))) {
+      promise->MaybeRejectWithOperationError("Invalid private grant file");
+      return;
+    }
+    DispatchAndResolve<nsTArray<uint8_t>>(
+        state->mEventQueue, promise,
+        [file = std::move(file)]() -> Result<nsTArray<uint8_t>, IOError> {
+          // Retain the checked descriptor. A replaced path cannot redirect the read.
+          nsAutoCString nativePath;
+          if (NS_FAILED(file->GetNativePath(nativePath))) {
+            return Err(IOError(NS_ERROR_FILE_ACCESS_DENIED, "Invalid private grant file"));
+          }
+          volparossa::GrantBytes grant;
+          size_t length;
+          if (!volparossa::ReadPrivateGrant(nativePath.get(), grant, length)) {
+            return Err(IOError(NS_ERROR_FILE_ACCESS_DENIED, "Cannot read private grant file"));
+          }
+          nsTArray<uint8_t> bytes;
+          bytes.AppendElements(grant.data(), length);
+          return bytes;
+        });
+  });
+}
+#endif
+
